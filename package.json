{
  "name": "@pablo_clueless/sniffr",
  "version": "0.1.0",
  "description": "Watch live API responses, model what they actually return, and diff that against your zod schemas.",
  "license": "MIT",
  "author": "smsnmicheal",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/adapters/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/adapters/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/adapters/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./solid": {
      "types": "./dist/adapters/solid.d.ts",
      "import": "./dist/solid.js"
    },
    "./ci": {
      "types": "./dist/ci/cli.d.ts",
      "import": "./dist/ci.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sniffr": "./dist/ci.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "api",
    "schema",
    "zod",
    "drift",
    "breaking-changes",
    "devtools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablo-clueless/sniffr.git"
  },
  "bugs": {
    "url": "https://github.com/pablo-clueless/sniffr/issues"
  },
  "homepage": "https://github.com/pablo-clueless/sniffr#readme",
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint && node scripts/check-invariants.mjs",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "example": "tsx example/drift.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "react": ">=18",
    "solid-js": ">=1.8",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.0",
    "solid-js": "^1.9.15",
    "tsdown": "^0.22.14",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.22",
    "zod": "^4.4.3",
    "zod-v3": "npm:zod@^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
